# Copy to .env.local for local overrides. Every variable is optional.

# The site's public address, used for share images, canonical metadata and
# the schema.org data. Set it once the portfolio has its own domain.
# Without it: Vercel's production URL on Vercel, http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://jeffersonveloso.dev

# Set by Vercel at build time; do not set it by hand.
# VERCEL_PROJECT_PRODUCTION_URL=

# `vercel link` and `vercel env pull` write a VERCEL_OIDC_TOKEN to .env.local.
# The site does not read it, and it must never be committed.
